# Copernicus Data Space Ecosystem credentials, used to download Sentinel-2 imagery.
# Register for free at https://dataspace.copernicus.eu
#
# Copy this file to .env and fill in your own values:
#   cp .env.example .env && chmod 600 .env
#
# Only the Sentinel steps need these (make sentinel, make arquivo, make secura).
# The model, the maps and the web app all run without them.
CDSE_USERNAME=
CDSE_PASSWORD=
